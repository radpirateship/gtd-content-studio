# Content Studio v2 — environment variables (values live in Vercel project settings)
#
# Existing (already set in Vercel; listed here for reference only)
# SITE_PASSWORD=            site-wide login gate (middleware.ts)
# CONTENT_BRAIN_API_KEY=    x-api-key for /api/content-brain/* automation
# DATABASE_URL=             Neon Postgres
# SHOPIFY_ACCESS_TOKEN=     Admin API token for the Dev Dashboard app
#
# Bot read-only products API (see docs/bot-products-api.md)
# Bearer token for GET /api/bot/products and /api/bot/products/<handle>.
# Generate with: openssl rand -hex 32   (64 hex chars). Unset = bot path disabled.
# CONTENT_STUDIO_BOT_TOKEN is accepted as an alias.
BOT_API_TOKEN=
